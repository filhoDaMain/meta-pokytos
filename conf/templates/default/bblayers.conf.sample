# LAYERS_CONF_VERSION is increased each time build/conf/bblayers.conf
# changes incompatibly
LAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BSP_LAYER_RPI = "${TOPDIR}/../layers/meta-raspberrypi"
BSP_LAYER_SUNXI = "${TOPDIR}/../layers/meta-sunxi"
BSP_LAYER_ARM = "${TOPDIR}/../layers/meta-arm/meta-arm"
BSP_LAYER_ARM_TOOLCHAIN = "${TOPDIR}/../layers/meta-arm/meta-arm-toolchain"


BBLAYERS ?= " \
  ${TOPDIR}/../layers/openembedded-core/meta \
  ${TOPDIR}/../layers/meta-openembedded/meta-oe \
  ${TOPDIR}/../layers/meta-openembedded/meta-python \
  ${TOPDIR}/../layers/meta-openembedded/meta-multimedia \
  ${TOPDIR}/../layers/meta-openembedded/meta-networking \
  ${TOPDIR}/../layers/meta-yocto/meta-poky \
  ${TOPDIR}/../layers/meta-yocto/meta-yocto-bsp \
  ${TOPDIR}/../layers/meta-pokytos \
  ${TOPDIR}/../layers/meta-pokytos-bsp \
  ${BSP_LAYER_RPI} \
  ${BSP_LAYER_SUNXI} \
  ${BSP_LAYER_ARM} \
  ${BSP_LAYER_ARM_TOOLCHAIN} \
"
